package build
import mill.*, scalalib.*, scalalib.publish.*
import mill.api.BuildCtx

object tda4j extends Cross[TDA4jModule]("3.8.3", "3.8.4", "3.9.0", "3.10.0-RC3")
trait TDA4jModule extends CrossScalaModule, PublishModule {
  def artifactName = "tda4j"
  def publishVersion = "0.5.0"

  def pomSettings = PomSettings(
    description = "A Java Platform compatible library for topological data analysis (TDA).",
    organization = "org.appliedtopology",
    url = "https://github.com/appliedtopology/tda4j",
    licenses = Seq(License.MIT),
    versionControl = VersionControl.github("appliedtopology", "tda4j"),
    developers = Seq(Developer("michiexile", "Mikael Vejdemo-Johansson", "https://github.com/michiexile"))
  )

  def scalaVersion = "3.8.4" // change to 3.9.x once the javascript bugs in 3.9.0 scaladoc are fixed

  def extraSources = Task.Sources("algebra", "alpha", "barcode", "cells", "cli", "homology", "io", "matlab", "streams", "unicode")

  def sources = Task {
    super.sources() ++ extraSources()
  }
  
  def mvnDeps = Seq(
    mvn"org.apache.commons:commons-numbers-combinatorics:1.1",
    mvn"org.apache.commons:commons-math3:3.6.1",
    mvn"com.eatthepath:jvptree:0.2",
    mvn"com.dreizak:miniball:1.0.3",
    mvn"org.scala-lang.modules::scala-parallel-collections:1.0.4",
    mvn"org.rogach::scallop:6.0.0",
    mvn"org.typelevel::cats-kernel:2.13.0",
    mvn"org.typelevel::cats-core:2.13.0",
    mvn"org.typelevel::kittens:3.5.0",
  )
  object test extends ScalaTests, TestModule.Specs2 {
    def mvnDeps = Seq(
      mvn"org.specs2::specs2-core:5.5.1",
      mvn"org.specs2::specs2-matcher-extra:5.5.1",
      mvn"org.specs2::specs2-scalacheck:5.5.1",
      mvn"org.scalacheck::scalacheck:1.17.0",
    )

    def extraSources = Task.Sources("algebra", "alpha", "barcode", "cells", "cli", "homology", "io", "matlab", "streams")

    def sources = Task {
      super.sources() ++ extraSources()
    }
  }

  def mainClass = Some("\"org.appliedtopology.tda4j.cli.TDA4jCLI")

  def scalacOptions = Seq(
    "-deprecation",
    "-encoding", "UTF-8",
    "-feature", "-unchecked",
    "-source:future", "-language:experimental.modularity", "-preview"
  )

  def scalaDocOptions = Task {
    Seq(
      "-siteroot", (BuildCtx.workspaceRoot / "tda4j" / "docs").toString,
      "-project", artifactName(),
      "-project-version", publishVersion(),
      "-source-links", "github://appliedtopology/tda4j/scala",
      "-Yapi-subdirectory",
      "-project-logo", (BuildCtx.workspaceRoot / "tda4j" / "docs" / "_assets" / "images" / "header-icon.svg").toString,
      "-doc-canonical-base-url", "https://tda4j.appliedtopology.org",
      "-social-links:github::https://github.com/appliedtopology/tda4j",
      "-doc-footer", "TDA4j is built by the TDA @ CUNY workgroup",
      "-quick-links:Applied Topology::https://appliedtopology.org,Playground::https://scastie.scala-lang.org/?inputs=%7B%0A%20%20%22_isWorksheetMode%22%20%3A%20true%2C%0A%20%20%22code%22%20%3A%20%22import%20org.appliedtopology.tda4j.*%5Cn%E2%88%86(1%2C2%2C3)%5Cn%22%2C%0A%20%20%22target%22%20%3A%20%7B%0A%20%20%20%20%22scalaVersion%22%20%3A%20%223.9.0%22%2C%0A%20%20%20%20%22tpe%22%20%3A%20%22Scala3%22%0A%20%20%7D%2C%0A%20%20%22libraries%22%20%3A%20%5B%20%5D%2C%0A%20%20%22librariesFromList%22%20%3A%20%5B%20%5D%2C%0A%20%20%22sbtConfigExtra%22%3A%22%5CnscalacOptions%20%2B%2B%3D%20Seq(%5Cn%20%20%5C%22-deprecation%5C%22%2C%5Cn%20%20%5C%22-encoding%5C%22%2C%20%5C%22UTF-8%5C%22%2C%5Cn%20%20%5C%22-feature%5C%22%2C%5Cn%20%20%5C%22-unchecked%5C%22%2C%5Cn%20%20%5C%22-source%3Afuture%5C%22%2C%20%5Cn%20%20%5C%22-language%3Aexperimental.modularity%5C%22%5Cn)%5CnlibraryDependencies%20%2B%3D%20%5C%22org.appliedtopology%5C%22%20%25%25%20%5C%22tda4j%5C%22%20%25%20%5C%220.4.0%5C%22%5Cn%22%2C%0A%20%20%22sbtPluginsConfigExtra%22%20%3A%20%22%22%2C%0A%20%20%22isShowingInUserProfile%22%20%3A%20true%0A%7D%0A",
      "-scastie-configuration",
      """
        |  scalacOptions ++= Seq(
        |    "-deprecation",
        |    "-encoding", "UTF-8",
        |    "-feature", "-unchecked",
        |    "-source:future", "-language:experimental.modularity",
        |    "-language:implicitConversions", "-language:adhocExtensions"
        |  ) ;
        |  libraryDependencies += "org.appliedtopology" %% "tda4j" % "0.4.0"
        |""".stripMargin.replace("\n", "")
    )
  }
}